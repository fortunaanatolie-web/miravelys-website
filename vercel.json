{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/en/origin",
      "destination": "/story",
      "permanent": true
    },
    {
      "source": "/en/privacy-policy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/en/user-agreement",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/en",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/support.html",
      "destination": "/support",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/terms.html",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/origin",
      "destination": "/story",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/user-agreement",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/:lang/origin",
      "destination": "/:lang/story",
      "permanent": true
    },
    {
      "source": "/:lang/privacy-policy",
      "destination": "/:lang/privacy",
      "permanent": true
    },
    {
      "source": "/:lang/user-agreement",
      "destination": "/:lang/terms",
      "permanent": true
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
